{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 6,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,

  "modules-left": [],
  "modules-center": [
    "custom/omarchy",
    "hyprland/workspaces",
    "clock",
    "mpris",
    "network",
    "bluetooth",
    "pulseaudio",
    "cpu",
    "battery",
    "tray"
  ],
  "modules-right": [],

  "custom/omarchy": {
    "format": "<span font='omarchy'></span>",
    "on-click": "omarchy-menu",
    "on-click-right": "xdg-terminal-exec",
    "tooltip-format": "Omarchy Menu  ·  Super+Alt+Space"
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "active":   "<span foreground='#ff4444' size='14336'>●</span>",
      "occupied": "<span size='8192'>●</span>",
      "empty":    "<span size='6144'>●</span>",
      "default":  "<span size='8192'>●</span>"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a, %d %b}",
    "tooltip": false,
    "on-click-right": "omarchy-launch-floating-terminal-with-presentation omarchy-tz-select"
  },

  "mpris": {
    "format": "{status_icon}  {title}",
    "format-paused": "{status_icon}  {title}",
    "status-icons": {
      "playing": "▶",
      "paused": "⏸",
      "stopped": "⏹"
    },
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "max-length": 28,
    "tooltip-format": "{title} — {artist}"
  },

  "network": {
    "format-wifi": "<span size='16384'>󰖩</span><span rise='4096'> {essid}</span>",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{signalStrength}% signal",
    "tooltip-format-ethernet": "Ethernet",
    "tooltip-format-disconnected": "No connection",
    "interval": 5,
    "on-click": "omarchy-launch-wifi"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {device_alias}",
    "format-no-controller": "",
    "tooltip-format": "{num_connections} device(s) connected",
    "on-click": "omarchy-launch-bluetooth"
  },

  "pulseaudio": {
    "format": "<span size='16384'>{icon}</span><span rise='4096'> {volume}%</span>",
    "format-muted": "󰖁 muted",
    "on-click": "omarchy-launch-audio",
    "on-click-right": "pamixer -t",
    "scroll-step": 5,
    "tooltip": false,
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    }
  },

  "cpu": {
    "interval": 5,
    "format": "<span size='16384'>󰍛</span><span rise='4096'> {usage}%</span>",
    "on-click": "omarchy-launch-or-focus-tui btop"
  },

  "battery": {
    "format": "{icon} <span foreground='#999999'>{capacity}%</span>",
    "format-charging": "{icon} <span foreground='#999999'>{capacity}%</span>",
    "format-plugged": "󰚥 <span foreground='#999999'>{capacity}%</span>",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "tooltip-format": "{power:>1.0f}W · {capacity}%",
    "interval": 5,
    "on-click": "omarchy-menu power",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "tray": {
    "icon-size": 11,
    "spacing": 8
  }
}
